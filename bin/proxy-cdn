#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Command line of the proxy (symfony/console). Commands:
 *
 *   check-env [--informational]   validate the configuration and the host
 *   cache:purge <url>...          purge URLs here and on CLUSTER_PEERS
 *   cache:evict                   evict LRU entries down to CACHE_MAX_SIZE
 *   cache:warmup <source>         request a sitemap or a URL list
 */

use Mfonte\ProxyCdn\Config\ConfigLoader;
use Mfonte\ProxyCdn\Console\CacheEvictCommand;
use Mfonte\ProxyCdn\Console\CachePurgeCommand;
use Mfonte\ProxyCdn\Console\CacheWarmupCommand;
use Mfonte\ProxyCdn\Console\CheckEnvCommand;
use Mfonte\ProxyCdn\Console\Installation;
use Symfony\Component\Console\Application;

$projectRoot = dirname(__DIR__);
// The Composer install hooks pass --informational: whatever happens, they
// must not fail the install (finding P-20).
// $_SERVER['argv'] rather than $argv: PHPStan leaves $argv undefined when
// register_argc_argv is off, as on the php:8.5-cli image.
$arguments = is_array($_SERVER['argv'] ?? null) ? $_SERVER['argv'] : [];
$failureExitCode = in_array('--informational', $arguments, true) ? 0 : 1;

if (!is_file($projectRoot . '/vendor/autoload.php')) {
    fwrite(STDERR, 'Dependencies are missing. Run: composer install' . PHP_EOL);
    exit($failureExitCode);
}

try {
    require $projectRoot . '/vendor/autoload.php';
} catch (\Throwable $exception) {
    // Composer's platform check throws when vendor/ was resolved for another PHP.
    fwrite(STDERR, 'The dependencies cannot be loaded: ' . $exception->getMessage() . PHP_EOL);
    exit($failureExitCode);
}

$version = 'UNKNOWN';
if (class_exists(\Composer\InstalledVersions::class)) {
    try {
        $version = (string) \Composer\InstalledVersions::getPrettyVersion('mfonte/proxy-cdn');
    } catch (\OutOfBoundsException $exception) {
        $version = 'UNKNOWN';
    }
}

$application = new Application('proxy-cdn', $version);
$installation = new Installation(new ConfigLoader($projectRoot . '/.env'), $projectRoot);
$application->addCommands([
    new CheckEnvCommand(new ConfigLoader($projectRoot . '/.env'), null, null, null, $projectRoot),
    new CachePurgeCommand($installation),
    new CacheEvictCommand($installation),
    new CacheWarmupCommand($installation),
]);

exit($application->run());
