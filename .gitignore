# Ignore everything, including sub-directories...
*
!*/

# ...but keep these specific files (rooted paths so the whitelist does not
# match homonymous files under vendor/, e.g. vendor/*/composer.json).
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/bootstrap.php
!/composer.json
!/public/.htaccess
!/public/index.php
!/helpers/functions.php
!/scripts/check-env.php

# Re-ignore vendor (it gets re-created by composer install).
/vendor/

# Runtime artifact: the rendered config cache. Never commit it.
/.cached.env.php
