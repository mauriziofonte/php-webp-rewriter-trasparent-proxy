# Composer: no lock file is committed (one lock cannot serve PHP 7.2 and 8.5)
/vendor/
/tools/*/vendor/
composer.lock

# Tool caches
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache

# Runtime configuration: .env holds deployment secrets, .cached.env.php is the
# compiled configuration rendered from it.
/.env
/.cached.env.php

# Runtime logs
/logs/

# Temporary files of atomicWrite() (helpers/functions.php), left behind when
# a write is interrupted between tempnam() and rename(), for example next to
# .cached.env.php in the project root.
.mftpcdn.*

# Cache entries: the proxy stores fetched assets inside public/ so that the
# web server can serve hits directly. Only the front controller and the
# server configuration are part of the repository.
/public/*
!/public/index.php
!/public/.htaccess
