# =============================================================================
# PHP Proxy CDN - official Apache configuration (public/.htaccess)
#
# Apache serves every cache hit itself, without PHP: the file of the host
# and of the query string under public/_cache/ (Cache\CacheKeyResolver),
# as its AVIF or WEBP variant or its Brotli or gzip encoding when the
# client accepts it. Everything else reaches index.php: misses, query
# strings that PHP must map, PURGE and OPTIONS.
#
# Requirements (see config/apache/proxy-cdn.conf for a virtual host):
#   - DocumentRoot is public/, with "AllowOverride All";
#   - mod_rewrite, mod_headers, mod_setenvif, mod_env and mod_mime;
#   - UseCanonicalName Off (the default): the cache directory is named
#     after the Host header;
#   - behind a TLS-terminating proxy, the virtual host sets PROXYCDN_HTTPS
#     for the addresses of TRUSTED_PROXIES only (see section 2);
#   - the plain-HTTP virtual host sets PROXYCDN_HOST for the hosts of
#     PROXY_HOSTS, the only ones redirected to https (see section 2).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Basic hardening
# -----------------------------------------------------------------------------
Options -Indexes -MultiViews

# If the VirtualHost lives on a filesystem where symlinks could exist under
# DocumentRoot, uncomment the next line to refuse to follow symlinks that
# are not owned by the Apache user.
# Options +SymLinksIfOwnerMatch

ErrorDocument 403 "Access Forbidden"

# Deny direct HTTP access to project metadata, the compiled configuration
# (.config.cache.php, and .cached.env.php left by 2.x) and the scratch tmp
# files written by FilesystemStorage in the microsecond window between
# tempnam() and rename().
<FilesMatch "^(\.(ht.*|git.*|env.*|cached\.env\.php|config\.cache\.php|mftpcdn\..*)|composer\.(json|lock)|(README|readme)\.md|LICENSE|license)$">
    Require all denied
</FilesMatch>

# Deny access to the negative-cache markers that 2.x left next to the
# cache files (3.0 keeps its state in var/ of the project).
<FilesMatch "\.(404|netfail)$">
    Require all denied
</FilesMatch>

# PHP prints the errors it raises before the proxy runs (such as a body
# above post_max_size) by its php.ini, which may display them: they would
# become the body, and turn the status of the proxy into a 200 text/html.
# Off for PHP-FPM (a FastCGI parameter, which public/index.php and DEBUG
# cannot turn back on; Apache passes no "\n", and PHP shows a startup
# error only when display_errors is on) and for mod_php (which then needs
# "AllowOverride Options" as well).
<IfModule mod_env.c>
    SetEnv PHP_ADMIN_VALUE "display_errors=Off"
</IfModule>
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
</IfModule>

# -----------------------------------------------------------------------------
# 2. HTTPS redirect + routing
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS. X-Forwarded-Proto is NOT read here: any client can send
    # it. Behind a TLS-terminating proxy, the virtual host sets the
    # variable PROXYCDN_HTTPS for the addresses of that proxy only, the
    # TRUSTED_PROXIES of the proxy configuration:
    #   SetEnvIfExpr "-R '10.0.0.0/8' && %{HTTP:X-Forwarded-Proto} == 'https'" PROXYCDN_HTTPS=on
    # The target names the host without the port of the plain-HTTP
    # request (SERVER_NAME is the Host header without its port, with
    # UseCanonicalName Off): HTTPS is served on 443, and the shipped nginx
    # configuration redirects the same way. Only the hosts of PROXY_HOSTS
    # are redirected, never to a name the proxy does not serve (PHP answers
    # those with 421): the virtual host lists them, in PROXYCDN_HOST,
    #   SetEnvIfNoCase Host "^(cdn\.example\.com|static\.example\.org)(:[0-9]+)?$" PROXYCDN_HOST=on
    # and so may this file, above this section, where the virtual host
    # cannot be changed. Browsers and shared caches do not store the
    # redirect (no-store, section 3).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{ENV:PROXYCDN_HTTPS} !=on
    RewriteCond %{ENV:PROXYCDN_HOST} =on
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [L,R=301,E=PROXYCDN_REDIRECT:1]

    # Entry point must always reach PHP.
    RewriteRule ^index\.php$ - [L]

    # No rule refuses "vendor/", "src/", "bin/" or "logs/": this file
    # applies below public/ only, where none of them exists, and an
    # origin may well serve "/vendor/livewire/livewire.js". The
    # DocumentRoot must be public/ (see config/apache/proxy-cdn.conf).

    # The cache is read through the rules below only, which apply the host
    # allowlist and the negotiation; the buckets of 2.x are never served.
    # A dot segment is never part of a path the proxy serves.
    RewriteRule ^(_cache|_qs)(/|$)      - [R=403,L]
    RewriteRule (^|/)\.                 - [R=403,L]

    # PURGE is answered by index.php, which checks the purge key (PURGE_KEYS);
    # the Authorization header reaches PHP-FPM and CGI through the environment.
    # OPTIONS goes there too, so that every CORS preflight gets the answer of
    # PHP, a cached file included.
    RewriteCond %{REQUEST_METHOD} ^(PURGE|OPTIONS)$
    RewriteRule ^ index.php [L,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The cache directory of the request, in PCDN_D: _cache/<host> without
    # query string, _cache/<host>/.q/<query> for a query string of plain
    # characters (PHP stores the entry there when the query string is the
    # canonical one). Only for GET and HEAD, and a host name in lower case;
    # an unlisted host has no directory, and reaches PHP, which answers 421.
    RewriteRule ^ - [E=PCDN_D:]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+(\.[a-z0-9-]+)*)\.?(:[0-9]{1,5})?$
    RewriteRule ^ - [E=PCDN_D:_cache/%1]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{QUERY_STRING} ^([A-Za-z0-9_~-][A-Za-z0-9._~=&-]{0,199})$
    RewriteCond %1|%{HTTP_HOST} ^([^|]+)\|([a-z0-9-]+(\.[a-z0-9-]+)*)\.?(:[0-9]{1,5})?$
    RewriteRule ^ - [E=PCDN_D:_cache/%2/.q/%1]

    # A hit: the first file that exists of the AVIF variant, the WEBP
    # variant, the Brotli encoding, the gzip encoding and the entry itself.
    # The variants and encodings count when the client lists them by name
    # without q=0 (Http\AcceptHeader). Paths of other characters than these
    # reach PHP, which serves them too. [END] serves the file without a
    # second pass through these rules.
    RewriteCond %{ENV:PCDN_D} .
    RewriteCond %{HTTP:Accept} (^|,)\s*image/avif\s*($|,|;(?![^,]*\bq\s*=\s*0(\.0*)?\s*($|,|;))) [NC,NV]
    RewriteCond %{DOCUMENT_ROOT}/%{ENV:PCDN_D}/.avif/$1.avif -f
    RewriteRule ^([A-Za-z0-9._~/-]+\.(?i:jpe?g|png|gif|bmp))$ %{ENV:PCDN_D}/.avif/$1.avif [END]

    RewriteCond %{ENV:PCDN_D} .
    RewriteCond %{HTTP:Accept} (^|,)\s*image/webp\s*($|,|;(?![^,]*\bq\s*=\s*0(\.0*)?\s*($|,|;))) [NC,NV]
    RewriteCond %{DOCUMENT_ROOT}/%{ENV:PCDN_D}/.webp/$1.webp -f
    RewriteRule ^([A-Za-z0-9._~/-]+\.(?i:jpe?g|png|gif|bmp))$ %{ENV:PCDN_D}/.webp/$1.webp [END]

    RewriteCond %{ENV:PCDN_D} .
    RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*br\s*($|,|;(?![^,]*\bq\s*=\s*0(\.0*)?\s*($|,|;))) [NC,NV]
    RewriteCond %{DOCUMENT_ROOT}/%{ENV:PCDN_D}/.br/$1 -f
    RewriteRule ^([A-Za-z0-9._~/-]+\.[A-Za-z0-9]+)$ %{ENV:PCDN_D}/.br/$1 [END]

    RewriteCond %{ENV:PCDN_D} .
    RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*gzip\s*($|,|;(?![^,]*\bq\s*=\s*0(\.0*)?\s*($|,|;))) [NC,NV]
    RewriteCond %{DOCUMENT_ROOT}/%{ENV:PCDN_D}/.gz/$1 -f
    RewriteRule ^([A-Za-z0-9._~/-]+\.[A-Za-z0-9]+)$ %{ENV:PCDN_D}/.gz/$1 [END]

    RewriteCond %{ENV:PCDN_D} .
    RewriteCond %{DOCUMENT_ROOT}/%{ENV:PCDN_D}/$1 -f
    RewriteRule ^([A-Za-z0-9._~/-]+\.[A-Za-z0-9]+)$ %{ENV:PCDN_D}/$1 [END]

    # Everything else: index.php.
    RewriteRule ^ index.php [L,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# -----------------------------------------------------------------------------
# 3. Response headers
#
# A hit carries the headers PHP sends with the files it serves
# (Http\ResponseFactory::assetHeaders()), and only a hit: PHP sends its own,
# and behind PHP-FPM a "Header set" next to a header from PHP sends it
# twice. The rules above serve a hit from an internal redirect to /_cache/,
# which these variables recognise.
# -----------------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_cache/" PCDN_HIT
    SetEnvIf Request_URI "^/_cache/[^/]+/(\.q/[^/]+/)?\.br/" PCDN_BR no-gzip
    SetEnvIf Request_URI "^/_cache/[^/]+/(\.q/[^/]+/)?\.gz/" PCDN_GZ no-gzip
    SetEnvIf Request_URI "\.(?i:jpe?g|png|gif|bmp)(\.avif|\.webp)?$" PCDN_RASTER
    SetEnvIf Request_URI "\.(?i:css|js|mjs|json|map|svg|txt|xml|ico|ttf|ttc|otf|eot)$" PCDN_TEXT
    SetEnvIf Request_URI "\.(?i:svg)$" PCDN_SVG
    # Do not set ap_trust_cgilike_cl. Since 2.4.59 (CVE-2024-24795)
    # mod_proxy_fcgi drops the Content-Length PHP sends and frames the
    # body itself (chunked, or a length it counted), so a response PHP
    # cuts short or overruns can never desynchronise a keep-alive
    # connection. The price: a response of PHP may come without
    # Content-Length, and a HEAD answered by PHP always does.
</IfModule>

<IfModule mod_headers.c>
    # No server fingerprint, and no version (finding P-23).
    Header unset Server
    Header always unset X-Powered-By
    Header always set X-Powered-By "MF Static Assets Cacher"

    # Cache-Control must carry the CACHE_EXPIRY of the proxy.
    Header set Cache-Control "public, max-age=31536000, must-revalidate" env=PCDN_HIT
    Header set X-Cache-Status "HIT" env=PCDN_HIT
    Header set Access-Control-Allow-Origin "*" env=PCDN_HIT
    Header set Cross-Origin-Resource-Policy "cross-origin" env=PCDN_HIT
    Header set Timing-Allow-Origin "*" env=PCDN_HIT
    Header set X-Content-Type-Options "nosniff" env=PCDN_HIT
    Header unset Set-Cookie env=PCDN_HIT
    # An SVG opened from this origin is sandboxed and runs no script
    # (finding P-7): the policy of Http\ResponseFactory, which PHP sends.
    Header set Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; sandbox" env=PCDN_SVG
    Header set Content-Encoding "br" env=PCDN_BR
    Header set Content-Encoding "gzip" env=PCDN_GZ
    Header merge Vary "Accept" env=PCDN_RASTER
    Header merge Vary "Accept-Encoding" env=PCDN_TEXT

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # The redirect to https of section 2 is never stored.
    Header always set Cache-Control "no-store" env=PROXYCDN_REDIRECT

    # HSTS. Default: host-only (no includeSubDomains / no preload) because
    # enabling them changes behavior of sibling hostnames. Uncomment the
    # wider variants ONLY if you understand the blast radius on your
    # eTLD+1 and its subdomains.
    Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ETag and Last-Modified of the files Apache serves.
FileETag MTime Size

<IfModule mod_mime.c>
    # The media types of Mfonte\ProxyCdn\Http\MediaTypes, which PHP uses for
    # the files it serves: a test keeps both lists identical (finding P-23).
    AddType text/css                           .css
    AddType text/javascript                    .js .mjs
    AddType application/json                   .json .map
    AddType image/svg+xml                      .svg
    AddType image/webp                         .webp
    AddType image/avif                         .avif
    AddType image/vnd.microsoft.icon           .ico
    AddType image/bmp                          .bmp
    AddType image/gif                          .gif
    AddType image/jpeg                         .jpg .jpeg .jpe
    AddType image/png                          .png
    AddType image/apng                         .apng
    AddType image/tiff                         .tif .tiff
    AddType font/ttf                           .ttf
    AddType font/collection                    .ttc
    AddType font/otf                           .otf
    AddType font/woff                          .woff
    AddType font/woff2                         .woff2
    AddType application/vnd.ms-fontobject      .eot
    AddType application/pdf                    .pdf
    AddType text/plain                         .txt
    AddType application/xml                    .xml
    AddType video/mp4                          .mp4
    AddType video/webm                         .webm
    AddType audio/mpeg                         .mp3
</IfModule>

# -----------------------------------------------------------------------------
# 4. Compression
#
# The proxy stores Brotli and gzip encodings of the text files
# (PRECOMPRESS); mod_deflate compresses the rest, and never an encoding.
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/plain text/xml text/html
    AddOutputFilterByType DEFLATE text/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml image/vnd.microsoft.icon
    AddOutputFilterByType DEFLATE font/ttf font/collection font/otf application/vnd.ms-fontobject
</IfModule>
