# =============================================================================
# PHP Transparent Proxy CDN - Apache configuration
#
# Serves cached static assets from disk and forwards everything else to
# index.php (the transparent proxy).
#
# Design note: requests that carry a non-empty query string (other than the
# proxy's own purge= / purge_all=) ALWAYS go through index.php, because
# Apache cannot derive the QS-keyed cache path on its own (it would need an
# md5 RewriteMap). PHP reads the cache entry from disk and serves it; the
# extra PHP hop is the price of correctness for cache-busted URLs.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Basic hardening
# -----------------------------------------------------------------------------
Options -Indexes -MultiViews

# If the VirtualHost lives on a filesystem where symlinks could exist under
# DocumentRoot, uncomment the next line to refuse to follow symlinks that
# are not owned by the Apache user.
# Options +SymLinksIfOwnerMatch

ErrorDocument 403 "Access Forbidden"

# Deny direct HTTP access to project metadata, the compiled configuration
# (.config.cache.php, and .cached.env.php left by 2.x) and the scratch tmp
# files written by FilesystemStorage in the microsecond window between
# tempnam() and rename().
<FilesMatch "^(\.(ht.*|git.*|env.*|cached\.env\.php|config\.cache\.php|mftpcdn\..*)|composer\.(json|lock)|(README|readme)\.md|LICENSE|license)$">
    Require all denied
</FilesMatch>

# Deny access to the negative-cache markers that 2.x left next to the
# cache files (3.0 keeps its state in var/ of the project).
<FilesMatch "\.(404|netfail)$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# 2. HTTPS redirect + routing
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS. Honor X-Forwarded-Proto so the proxy works behind a
    # TLS-terminating load balancer.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,QSA,R=301]

    # Entry point must always reach PHP.
    RewriteRule ^index\.php$ - [L]

    # Defensive 403s: never expose project internals even if somebody
    # mispoints the DocumentRoot at the project root instead of ./public.
    RewriteRule ^(.*/)?\.git(/.*)?$     - [R=403,L]
    RewriteRule ^(.*/)?vendor(/.*)?$    - [R=403,L]
    RewriteRule ^(.*/)?src(/.*)?$       - [R=403,L]
    RewriteRule ^(.*/)?bin(/.*)?$       - [R=403,L]
    RewriteRule ^(.*/)?logs(/.*)?$      - [R=403,L]
    # The proxy state (negative cache) lives in var/ of the project root.
    RewriteRule ^var(/.*)?$             - [R=403,L]

    # Refuse direct reads of the QS-bucket cache. The bucketing layout
    # (public/_qs/<sha256prefix>/) is an implementation detail; clients
    # MUST go through index.php so content negotiation stays applied.
    RewriteRule ^(.*/)?_qs(/.*)?$       - [R=403,L]

    # PURGE is answered by index.php, which checks the purge key (PURGE_KEYS);
    # the Authorization header reaches PHP-FPM and CGI through the environment.
    # The anonymous ?purge=1 of 2.x reaches index.php through the query-string
    # rule below and is answered 401.
    RewriteCond %{REQUEST_METHOD} =PURGE
    RewriteRule . index.php [L,QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ALWAYS route to index.php when the request has a non-empty query
    # string. index.php will canonicalize the QS, compute the per-QS cache
    # path and either serve the cached copy or fetch it from the origin.
    RewriteCond %{QUERY_STRING} .
    RewriteRule . index.php [L,QSA,E=REMOTE_USER:%{HTTP:Authorization}]

    # Cache miss for QS-less requests: forward to index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L,QSA,E=REMOTE_USER:%{HTTP:Authorization}]

    # Transparent WEBP for QS-less requests: if the client asked for a
    # raster image and a .webp sibling exists on disk, 301-redirect.
    # (QS-carrying requests are handled inside index.php via Accept
    #  negotiation, so they do not need this redirect.)
    RewriteCond %{REQUEST_URI} ^/(.+)\.(jpe?g|png|gif|bmp)$  [NC]
    RewriteCond %{DOCUMENT_ROOT}/%1.webp  -f
    RewriteRule ^(.+)\.(.+)$ /$1.webp [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# 3. Response headers and cache policy
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # CORS: static assets are fetched cross-origin from the main site.
    Header set Access-Control-Allow-Origin  "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Max-Age       "86400"

    # Strip server fingerprinting headers where possible.
    Header unset Server
    Header unset X-Powered-By

    # Light hardening applicable to a static-asset CDN.
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # An SVG opened from this origin is sandboxed and runs no script
    # (finding P-7): the policy of Http\ResponseFactory, which PHP sends.
    <FilesMatch "\.(?i:svg)$">
        Header set Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; sandbox"
    </FilesMatch>

    # HSTS. Default: host-only (no includeSubDomains / no preload) because
    # enabling them changes behavior of sibling hostnames. Uncomment the
    # wider variants ONLY if you understand the blast radius on your
    # eTLD+1 and its subdomains.
    Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Branding for cache-hit responses (files served directly by Apache),
    # without a version number (finding P-23).
    Header set X-Powered-By  "MF Static Assets Cacher"
    Header set X-Cache-Status "HIT"
</IfModule>

<IfModule mod_mime.c>
    # The media types of Mfonte\ProxyCdn\Http\MediaTypes, which PHP uses for
    # the files it serves: a test keeps both lists identical (finding P-23).
    AddType text/css                           .css
    AddType text/javascript                    .js .mjs
    AddType application/json                   .json .map
    AddType image/svg+xml                      .svg
    AddType image/webp                         .webp
    AddType image/avif                         .avif
    AddType image/vnd.microsoft.icon           .ico
    AddType image/bmp                          .bmp
    AddType image/gif                          .gif
    AddType image/jpeg                         .jpg .jpeg .jpe
    AddType image/png                          .png
    AddType image/apng                         .apng
    AddType image/tiff                         .tif .tiff
    AddType font/ttf                           .ttf
    AddType font/collection                    .ttc
    AddType font/otf                           .otf
    AddType font/woff                          .woff
    AddType font/woff2                         .woff2
    AddType application/vnd.ms-fontobject      .eot
    AddType application/pdf                    .pdf
    AddType text/plain                         .txt
    AddType application/xml                    .xml
    AddType video/mp4                          .mp4
    AddType video/webm                         .webm
    AddType audio/mpeg                         .mp3
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType application/json          "access plus 1 hour"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
    ExpiresByType image/bmp                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/tiff                "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/collection           "access plus 1 year"
    ExpiresByType font/otf                  "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType application/pdf           "access plus 1 month"
</IfModule>

# -----------------------------------------------------------------------------
# 4. Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/plain text/xml text/html
    AddOutputFilterByType DEFLATE text/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml image/bmp image/vnd.microsoft.icon
    AddOutputFilterByType DEFLATE font/ttf font/collection font/otf application/vnd.ms-fontobject
</IfModule>

# -----------------------------------------------------------------------------
# 5. ETag + Cache-Control for file-served responses
#
# NOTE: we deliberately use "must-revalidate" (not "immutable"). These URLs
# are not fingerprinted: the same /foo/bar.jpg may correspond to different
# bytes over time (after a purge=1 or after the origin overwrites the file).
# "immutable" would trap old bytes in browser caches for a full year.
# -----------------------------------------------------------------------------
<FilesMatch "\.(?i:css|js|json|svg|svgz|ico|bmp|gif|jpe?g|png|webp|tiff?|ttf|ttc|otf|eot|woff2?|pdf)$">
    FileETag MTime Size
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, must-revalidate"
        Header unset Set-Cookie
    </IfModule>
</FilesMatch>
