# Configuration of both nodes of the example (compose.yaml adds
# CLUSTER_PEERS to each). Replace the keys before any real use.
SOURCE_ORIGIN=http://origin
PROXY_HOSTS=cdn.example.test
CACHEABLE_EXTENSIONS=css,js,jpg,jpeg,png,gif,webp,svg,woff2
UPSTREAM_VERIFY_TLS=true
SENDFILE=x-accel-redirect
# The load balancer, so that each client has its own miss budget.
TRUSTED_PROXIES=172.30.99.10
MISS_RATE_LIMIT=600
# The same purge keys on every node: a peer signs its fan-out with them.
PURGE_KEYS=*=example-purge-key-change-me-0123456789
METRICS_KEYS=example-metrics-key-change-me-0123456789
# The private CA of setup.sh, which signed the certificate of each node.
CLUSTER_CA_FILE=/etc/proxy-cdn/ca.pem
CLUSTER_TIMEOUT=2
CACHE_MAX_SIZE=1G
CACHE_EXPIRY=31536000
# No image variants: the php image has no conversion backend for "local"
# (see "Image conversion" in the README), and this key must not come from
# the .env of the project. With "local" or "remote", each node keeps its
# pending images in its own cache (_cache/<host>/.pending) and its
# conversion state in its own var/.
IMAGE_CONVERTER=none
LOG_FILE=stderr
