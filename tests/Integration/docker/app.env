# .env of the application copies started by the integration harness.
# SOURCE_ORIGIN is the fake origin service of compose.yaml.
DEBUG = false
SOURCE_ORIGIN = "http://origin"
CACHEABLE_EXTENSIONS = "css,js,jpg,jpeg,png,gif,bmp,webp,ttf,woff,woff2,otf,eot,svg,ico"
CACHE_EXPIRY = 31536000
NEGATIVE_CACHE_TTL = 300
NETWORK_ERROR_TTL = 30
UPSTREAM_TIMEOUT = 10
UPSTREAM_CONNECT_TIMEOUT = 2
UPSTREAM_VERIFY_TLS = true
UPSTREAM_FOLLOW_REDIRECTS = false
CHARSET = "UTF-8"
TIMEZONE = "UTC"
LOCALE = "en_US"
IMAGE_CONVERSION_MODE = "none"
